# Imagem e usuário do Airflow
AIRFLOW_IMAGE_NAME=dataengine-airflow:3.3.0-python3.12
AIRFLOW_UID=50000
AIRFLOW_API_PORT=8080

# Usuário administrativo criado pelo airflow-init
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha

# Gere uma chave Fernet antes de usar fora de um ambiente local.
AIRFLOW_FERNET_KEY=

# Banco de metadados PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=airflow

# Credenciais somente no host; os diretórios são montados como somente leitura.
AWS_CREDENTIALS_DIR=C:/Users/SEU_USUARIO/.aws
GOOGLE_CREDENTIALS_DIR=C:/Users/SEU_USUARIO/AppData/Roaming/gcloud
DBT_PROFILES_DIR_HOST=C:/Users/SEU_USUARIO/.dbt

